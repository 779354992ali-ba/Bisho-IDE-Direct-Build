{
  "schemaVersion": 1,
  "status": "reference-only-not-provisioned",
  "targetAbi": "arm64-v8a",
  "deviceAndroidMinimumApi": 29,
  "flutter": {
    "version": "3.27.4",
    "source": "https://github.com/0xR0/arm64-flutter-setup",
    "archiveIntegrity": "community setup reference only; resolve and pin exact ARM64 Dart/Flutter source artifacts and checksums before provisioning; no official Linux ARM64 stable archive is assumed"
  },
  "java": {
    "major": 17,
    "vendor": "Temurin-or-equivalent-aarch64",
    "source": "https://adoptium.net/temurin/releases/",
    "archiveIntegrity": "must-be-resolved-from-vendor-checksum-and-signature"
  },
  "androidSdk": {
    "platformApi": 35,
    "buildToolsVersion": "35.0.1",
    "commandLineTools": "latest-pinned-release-required",
    "licenses": "must-be-accepted-and-stored-during-online-provisioning",
    "hostTools": {
      "requiredAbi": "linux-aarch64",
      "required": [
        "aapt2",
        "aidl",
        "zipalign",
        "split-select",
        "apksigner"
      ],
      "status": "ARM64 replacements are community-sourced; exact release, checksums, license, and in-rootfs execution must be pinned before packaging"
    }
  },
  "offlineCaches": [
    "flutter/bin/cache/artifacts/engine/android-arm64",
    "pub-cache",
    "gradle-wrapper-distributions",
    "gradle-modules-and-plugin-artifacts",
    "android-sdk-platforms-build-tools-platform-tools-licenses"
  ],
  "proofRequirements": {
    "debug": "build-a-real-arm64-debug-apk-with-network-disabled-and-verify-signature-and-zip-alignment",
    "release": "separate-release-aot-build-proof-and-artifact-verification",
    "noNetworkBuild": "must-be-demonstrated-after-first-online-provisioning"
  },
  "releaseAot": {
    "enabled": false,
    "reason": "Keep disabled until an Android-target Linux ARM64 gen_snapshot is available and a real Release APK passes on-device."
  }
}
